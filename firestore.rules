// Regras de seguranca do Firestore da FlowTickets.
//
// COMO APLICAR:
//   Firebase Console -> Build -> Firestore Database -> aba "Regras" (Rules)
//   -> apague o conteudo atual, cole ISTO abaixo e clique em "Publicar".
//
// O que elas fazem:
//   - Qualquer pessoa PODE LER os eventos (o site publico precisa disso).
//   - Somente quem estiver LOGADO (login do painel admin) pode ESCREVER.
//   - Nenhum outro caminho do banco fica acessivel.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /flow/dados {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
